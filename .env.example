# Copy to .env (gitignored, never commit it). Keys are baked in at build time.
# NOTE: personal app, so these keys end up inside the app bundle. Don't publish a build.

# TMDB: https://www.themoviedb.org/settings/api. Set ONE of these:
VITE_TMDB_API_KEY=
# VITE_TMDB_READ_TOKEN=

# Optional. OMDb critic scores (IMDb / Rotten Tomatoes / Metacritic): https://www.omdbapi.com/apikey.aspx
VITE_OMDB_KEY=
