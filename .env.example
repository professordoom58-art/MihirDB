# Copy to .env and fill in. (Keys can also be pasted in the app: Settings → API keys.)
# NOTE: personal app, so these keys are bundled into the client. Don't publish a build.

# TMDB: https://www.themoviedb.org/settings/api. Either the v3 "API Key" or the v4 "API Read Access Token" works.
VITE_TMDB_KEY=

# OMDb: https://www.omdbapi.com/apikey.aspx (free: 1,000 requests/day)
VITE_OMDB_KEY=

# Optional, release builds only: a proxy if your network blocks api.themoviedb.org
# (see proxy/tmdb-worker.js). Dev builds always use the built-in dev-server proxy.
VITE_TMDB_BASE=
