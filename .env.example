# Optional overrides. The TMDB key is already built into src/lib/config.ts,
# so you do NOT need this file to run the app. Anything set here wins at build
# time (useful for rotating the key without editing code). Gitignored.

# TMDB: https://www.themoviedb.org/settings/api. Set ONE to override the built-in key:
VITE_TMDB_API_KEY=
# VITE_TMDB_READ_TOKEN=

# Optional. OMDb critic scores (IMDb / Rotten Tomatoes / Metacritic): https://www.omdbapi.com/apikey.aspx
VITE_OMDB_KEY=
